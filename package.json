{
  "name": "ifhj",
  "version": "0.0.59",
  "private": true,
  "description": "i freaking have jira — a TUI for Jira",
  "license": "MIT",
  "bin": {
    "ifhj": "src/index.tsx"
  },
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun test",
    "compile": "DEV=false bun build --compile --minify ${TARGET:+--target=$TARGET} --outfile ifhj src/index.tsx",
    "dev": "bun --hot src/index.tsx",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint && tsc",
    "start": "bun run src/index.tsx",
    "test": "bun test"
  },
  "dependencies": {
    "github-markdown-adf": "^1.3.0",
    "ink": "^7.0.1",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.9.3"
  }
}
